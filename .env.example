# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commite o arquivo ".env" de verdade no Git.

# Chave secreta do Flask (sessions, tokens de recuperação de senha)
# Gere uma nova com: python -c "import secrets; print(secrets.token_hex(32))"
FLUXO_SECRET_KEY=

# Chave mestra para acessar o painel administrativo (/fluxo-control)
FLUXO_ADMIN_KEY=

# Token de segurança configurado no painel do Asaas para validar o webhook
WEBHOOK_TOKEN=

# Chaves da The Odds API (a segunda é usada como fallback/failover)
ODDS_API_KEY_1=
ODDS_API_KEY_2=

# Chave da API do Google Gemini (usada em ia_fluxo.py)
GEMINI_API_KEY=

# Chave da API do Asaas (pagamentos)
ASAAS_API_KEY=

# Credenciais de e-mail (recuperação de senha via Gmail SMTP)
EMAIL_USER=
EMAIL_PASS=
